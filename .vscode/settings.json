{
	// Makefile : make EXIGE de vraies tabulations avant chaque commande et refuse tout le reste
	// avec « missing separator ». C'est le premier blocage du module 10 ; on le désamorce ici.
	"[makefile]": {
		"editor.insertSpaces": false,
		"editor.detectIndentation": false
	},
	"files.associations": {
		"Makefile": "makefile",
		"makefile": "makefile",
		"*.mk": "makefile"
	},

	// IntelliSense pointée sur le gcc de MSYS2 : sans ça, l'extension C/C++ souligne
	// #include <stdio.h> en rouge alors que la compilation passe.
	"C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",
	"C_Cpp.default.cStandard": "c17",
	"C_Cpp.default.intelliSenseMode": "windows-gcc-x64",

	// Le C de ce dépôt suit le style du parcours : 4 espaces, pas de tabulation.
	"[c]": {
		"editor.insertSpaces": true,
		"editor.tabSize": 4,
		"editor.rulers": [90]
	},

	// Les binaires produits n'ont rien à faire dans l'explorateur ni dans la recherche.
	"files.exclude": {
		"**/exercices/bin": true
	},
	"search.exclude": {
		"build": true,
		".svelte-kit": true
	}
}
